            if not o.Enabled then return false, "Подсказка взаимодействия сейчас выключена игрой" end
            if self.capabilities.prompt then
                local ok, err = pcall(E.fireproximityprompt, o)
                return ok, ok and "Взаимодействие отправлено" or tostring(err)
            end
            local ok, err = pcall(function() o:InputHoldBegin() end)
            if not ok then return false, tostring(err) end
            self:Sleep(token, math.min(30, math.max(0, o.HoldDuration)) + 0.1)
            pcall(function() o:InputHoldEnd() end)
            return self:Alive(token), "Завершено удержание; проверяется результат"
        end
        if not isa(o, "BasePart") then return false, "Неизвестный тип взаимодействия" end
        if o.CanTouch == false then return false,"Касания этого объекта сейчас выключены игрой" end
        if self.capabilities.touch then
            local ok, err = pcall(E.firetouchinterest, root, part, 0)
            self:Sleep(token, 0.12)
            -- Закрытие уже начатого касания выполняется даже после отмены.
            pcall(E.firetouchinterest, root, part, 1)
            return ok and self:Alive(token), ok and "Касание отправлено" or tostring(err)
        end
        local ok, err = self:Move(part.Position + E.Vector3.new(0, 0.75, 0), token)
        if ok then self:Sleep(token, 0.35) end
        return ok and self:Alive(token), err or "Физический подбор; требуется подтверждение"
    end
    function C:ClassDetector(item)
        local classes = self:Resolve("classes")
        if not item.class or not classes then return nil end
        local class = find(classes, "Class" .. tostring(item.class))
        return find(find(class, "Button"), "ClickDetector")
    end
    function C:Claim(item, token)
        if self:FindTool(item) then return true, "Оружие уже при персонаже" end
        local detector = self:ClassDetector(item)
        if not detector then return false, "Бесплатная стойка отсутствует в этом плейсе" end
        local sent, why = self:Interact(detector, token)
        if not sent and why ~= "Требуется ручной клик" then return false, why end
        local ok = self:Wait(token, sent and 4 or 12, function() return self:FindTool(item) ~= nil end)
        if ok then return true, "Предмет появился у персонажа" end
        return false, "Стойка не выдала предмет: нужен бейдж, выполненное условие или живой тест"
    end
    function C:IsWorldPickup(o)
        if not o or not o.Parent or not self.aliasIndex[normal(o.Name)] then return false end
        local current = o.Parent
        while current and current ~= self.world do
            if isa(current, "Model") and current:FindFirstChildOfClass("Humanoid") then return false end
            if current.Name == "Classes" or current.Name == "ViewportFrame" then return false end
            current = current.Parent
        end
        if current ~= self.world then return false end
        local handle = isa(o, "BasePart") and o or find(o, "Handle", true)
        if not handle or not isa(handle, "BasePart") then return false end
        return isa(o, "Tool") or handle:FindFirstChildOfClass("TouchTransmitter") ~= nil
            or o:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
            or o:FindFirstChildWhichIsA("ClickDetector", true) ~= nil
    end
    function C:IndexPickup(o)
        if self:IsWorldPickup(o) then self.worldPickups[o] = true end
        -- Handle/TouchInterest могут реплицироваться после контейнера.
        if o.Parent and self:IsWorldPickup(o.Parent) then self.worldPickups[o.Parent] = true end
        if o.Parent and o.Parent.Parent and self:IsWorldPickup(o.Parent.Parent) then self.worldPickups[o.Parent.Parent] = true end
    end
    function C:FindPickup(item)
        if item.path and item.mode == "pickup" then
            local exact = self:Resolve(item.path)
            if exact then return exact end
        end
        local _, _, root = self:Character()
        local best, distance
        for object in pairs(self.worldPickups) do
            if not object.Parent then self.worldPickups[object] = nil
            elseif self:IsWorldPickup(object) and matches(object.Name, item.tools) then
                local part = self:PartOf(object)
                local d = root and (part.Position-root.Position).Magnitude or 0
                if not distance or d < distance then
                    best = object:FindFirstChildWhichIsA("ProximityPrompt", true)
                        or object:FindFirstChildWhichIsA("ClickDetector", true) or part
                    distance = d
                end
            end
        end
        return best
    end
    function C:EnemyAllowed(model)
        if not model or not model.Parent or self.players:GetPlayerFromCharacter(model) then return false end
        local f, n = self.settings.npcFilter, model.Name
        if f == 2 then return n == "NPC" or n == "NPC [Erde]" end
        if f == 3 then return n == "NPC 2.0" end
        if f == 4 then return n:find("Servant Of Celestial", 1, true) ~= nil end
        if f == 5 then return false end
        return true
    end
    function C:ScanEnemies()
        local now = self.clock()
        if now - self.scanAt < 2 then return end
        self.scanAt = now
        local list, seen = {}, {}
        local folder = find(self.world, "Enemies")
        local scanRoot = folder or self.world
        for _, object in ipairs(descendants(scanRoot)) do
            if isa(object, "Humanoid") and object.Parent and not seen[object.Parent] then
                local model = object.Parent
                local allowFallback = folder or model.Name:lower():find("npc", 1, true)
                    or model.Name:lower():find("enemy", 1, true) or model.Name:lower():find("zombie", 1, true)
                if allowFallback and self:EnemyAllowed(model) then
                    local part = find(model, "HumanoidRootPart") or find(model, "Torso") or find(model, "Head")
                    if part and isa(part, "BasePart") then
                        list[#list+1] = {model=model, part=part, health=object, humanoid=true}
                        seen[model] = true
                    end
                end
            end
        end
        if self.settings.npcFilter == 5 then
            local boss = self:Resolve({"Workspace", "World5", "Lazarus", "Boss"})
            local head = find(boss, "Head")
            local health = find(head, "Health")
            if head and type(value(health)) == "number" then
                list[#list+1] = {model=boss, part=head, health=health, humanoid=false}
            end
        end
        self.enemyCache = list
    end
    function C:EnemyHealth(enemy)
        if not enemy.model.Parent or not enemy.part.Parent or not enemy.health.Parent then return 0 end
        return enemy.humanoid and enemy.health.Health or (tonumber(value(enemy.health)) or 0)
    end
    function C:ChooseEnemy(root)
        self:ScanEnemies()
        local best, distance
        for _, enemy in ipairs(self.enemyCache) do
            if self:EnemyHealth(enemy) > 0 and self.clock() >= (self.enemySkip[enemy.model] or 0) then
                local d = (enemy.part.Position-root.Position).Magnitude
                if not distance or d < distance then best, distance = enemy, d end
            end
        end
        return best
    end
    function C:CombatStep(token)
        if not self:Alive(token) or not self.allowed then return false end
        local character, humanoid, root = self:Character()
        if not root then
            self:Log("ОЖИДАНИЕ", "Персонаж возрождается; фарм продолжится после появления.", "respawn", 5)
            return false
        end
        local selected = self.bridge.farm and self.bridge.farm[1] or self.selectedTool
        if not selected then
            self:Log("НУЖНО ОРУЖИЕ", "Выбери оружие во вкладке «Автофарм».", "weapon", 8)
            return false
        end
        local tool
        for _, candidate in ipairs(self:Tools()) do if candidate.Name == selected then tool = candidate break end end
        if not tool then
            self:Log("НУЖНО ОРУЖИЕ", "Выбранное оружие исчезло. После смерти получи его на стойке или выбери другое.", "lost_weapon", 8)
            return false
        end
        if tool.Parent ~= character then
            local ok = pcall(function() humanoid:EquipTool(tool) end)
            if not ok or tool.Parent ~= character then return false end
            self.lastAttack = self.clock()
            return true
        end
        local enemy = self:ChooseEnemy(root)
        if not enemy then self:Log("ОЖИДАНИЕ", "Подходящих живых NPC нет.", "no_enemy", 6) return false end
        local hp, now = self:EnemyHealth(enemy), self.clock()
        if self.target ~= enemy.model then
            self.target, self.targetHealth, self.targetDamageAt = enemy.model, hp, now
        elseif hp < (self.targetHealth or hp) then self.targetHealth, self.targetDamageAt = hp, now
        elseif now - (self.targetDamageAt or now) > 25 then
            self.enemySkip[enemy.model] = now + 45
            self.target = nil
            self:Log("ПРОВЕРКА", "Цель не получает урон. Проверь оружие или нужную способность; перебираю другие NPC.", "no_damage", 8)
            return false
        end
        if self.settings.follow and now - self.lastMove >= 0.18 then
            local cf = enemy.part.CFrame * E.CFrame.new(0, 1, self.settings.distance)
            if (root.Position-cf.Position).Magnitude > 1.8 then self:Move(cf.Position, token, enemy.part.Position) end
            self.lastMove = now
        end
        if now - self.lastAttack >= self.settings.attackInterval and self:Alive(token) then
            local ok, err = pcall(function() if tool.Enabled then tool:Activate() end end)
            self.lastAttack = now
            if not ok then self:Log("ОШИБКА", "Автоатака: "..tostring(err), "attack", 5) end
        end
        return true
    end
    function C:EquipFor(item, token)
        local tool = self:FindTool(item)
        if not tool then return false, "Нужное оружие отсутствует в рюкзаке" end
        local _, humanoid = self:Character()
        if not humanoid then return false, "Персонаж не готов" end
        humanoid:EquipTool(tool)
        self:Sleep(token, 0.2)
        if tool.Parent ~= self.player.Character then return false, "Экипировка оружия не подтверждена" end
        return true, tool
    end
    function C:CollectGoal(item, token, requirePhysical)
        local function satisfiedNow()
            if requirePhysical then return self:ItemEvidence(item) end
            return self:GoalSatisfied(item)
        end
        local satisfied, proof = satisfiedNow()
        if satisfied then return true, proof end
        if item.class then
            local ok, result = self:Claim(item, token)
            if ok then return true, result end
        end
        if not self:Alive(token) then return false, "Отменено" end
        local limit = item.mode == "drop" and self.settings.dropSeconds or self.settings.goalSeconds
        local finishAt, nextInteract = self.clock()+limit, 0
        self:Log("ЗАДАНИЕ", item.name .. ": " .. (item.mode=="drop" and "фарм NPC и проверка дропа" or "ожидание и подбор настоящего предмета"))
        while self:Alive(token) and self.clock() < finishAt do
            local ok, why = satisfiedNow()
            if ok then self.badgeRefreshAt = -1000 return true, why end
            if self:Character() then
                local pickup = self:FindPickup(item)
                if pickup and self.clock() >= nextInteract then
                    local sent, err = self:Interact(pickup, token)
                    if not sent and err ~= "Требуется ручной клик" then self:Log("ОЖИДАНИЕ", err, "pickup:"..item.id, 8) end
                    nextInteract = self.clock()+2
                    self:Wait(token, 1.3, function() return satisfiedNow() end)
                elseif item.mode == "drop" then self:CombatStep(token) end
            end
            if not self:Sleep(token, 0.15) then break end
        end
        return false, self:Alive(token) and "Предмет или бейдж за отведённое время не подтверждён" or "Отменено"
    end
    function C:ReadPrice(detector, unit)
        if not detector then return nil end
        local labelRoot = detector.Parent
        local prices = {}
        for _, object in ipairs(descendants(labelRoot)) do
            if isa(object, "TextLabel") or isa(object, "TextButton") then
                local n = numericCost(object.Text, unit)
                if n then prices[n] = true end
            end
        end
        local result
        for n in pairs(prices) do if result ~= nil then return nil end result = n end
        return result
    end
    function C:FindUpgrade(item)
        if item.path then return self:Resolve(item.path) end
        local root = self:Resolve("upgrades")
        if not root then return nil end
        local base = self.items[item.upgradeOf]
        local result
        for _, candidate in ipairs(descendants(root)) do
            if isa(candidate, "ClickDetector") or isa(candidate, "ProximityPrompt") then
                local labelRoot, eligible = candidate.Parent, false
                if matches(labelRoot.Name, base.tools) then eligible = true end
                for _, label in ipairs(descendants(labelRoot)) do
                    if isa(label, "TextLabel") or isa(label, "TextButton") then
                        local text = normal(label.Text)
                        for _, alias in ipairs(base.tools or {}) do
                            if text:find(normal(alias), 1, true) then eligible = true end
                        end
                    end
                end
                if eligible then if result then return nil end result = candidate end
            end
        end
        return result
    end
    function C:AskCost(token, title, detail)
        self.confirmation = {token=token, title=title, detail=detail, result=nil, deadline=self.clock()+35}
        self:Log("ПОДТВЕРЖДЕНИЕ", title .. ". Подтверди расход в верхней панели; без подтверждения клика не будет.")
        local decision = self.confirmation
        while self:Alive(token) and self.clock() < decision.deadline and decision.result == nil do
            self:Sleep(token, 0.1)
        end
        if self.confirmation == decision then self.confirmation = nil end
        return self:Alive(token) and decision.result == true
    end
    function C:Confirm(approve)
        local decision = self.confirmation
        if decision and decision.token == self.epoch and self.clock() < decision.deadline then
            decision.result = approve == true
        end
    end
    function C:Upgrade(item, token)
        if self:GoalSatisfied(item) then return true, "Улучшение уже подтверждено" end
        local detector = self:FindUpgrade(item)
        if not detector then return false, "Однозначная кнопка этого улучшения не найдена. Вызов не выполнялся." end
        local base = self.items[item.upgradeOf]
        if not self:FindTool(base) then return false, "Сначала получи базовое оружие: " .. base.name end
        local cost = self:ReadPrice(detector, "Kills")
        local kills = self:Stat("Kills")
        if not cost then return false, "Нельзя прочитать однозначную цену в убийствах на текущей кнопке" end
        if not kills then return false, "Текущее количество убийств не читается; расход заблокирован" end
        if kills < cost then return false, "Недостаточно убийств: " .. tostring(kills) .. " / " .. tostring(cost) end
        if not self:AskCost(token, item.name, "Стоимость: " .. tostring(cost) .. " убийств. Будет одно нажатие.") then
            return false, "Расход не подтверждён"
        end
        if detector ~= self:FindUpgrade(item) or self:ReadPrice(detector, "Kills") ~= cost then
            return false, "Кнопка или цена изменилась; расход отменён"
        end
        if (self:Stat("Kills") or -1) < cost then return false, "Баланс изменился; расход отменён" end
        local equipped, why = self:EquipFor(base, token)
        if not equipped then return false, why end
        local sent, err = self:Interact(detector, token)
        if not sent and err ~= "Требуется ручной клик" then return false, err end
        self.badgeRefreshAt = -1000
        local ok = self:Wait(token, 18, function() return self:GoalSatisfied(item) end)
        if ok then return true, "Улучшение подтверждено предметом или бейджем" end
        return false, "Нажатие было одно. Подтверждения улучшения нет; повторного расхода не будет."
    end
    function C:Trade(token)
        local detector = self:Resolve("trade")
        if not detector then return false, "Торговец не найден" end
        local kills, fragments = self:Stat("Kills"), self:Stat("Fragments")
        if not kills or not fragments then return false, "Баланс убийств или фрагментов не читается; обмен остановлен" end
        local liveText = {}
        for _, label in ipairs(descendants(detector.Parent)) do
            if isa(label, "TextLabel") then liveText[#liveText+1] = label.Text end
        end
        local text = table.concat(liveText, " ")
        local k, f = numericCost(text, "Kills"), numericCost(text, "Fragments")
        if not k or not f then return false, "Условия обмена на текущей табличке не читаются" end
        if kills < k and fragments < f then return false, "Ресурсов недостаточно для условий обмена" end
        if not self:AskCost(token, "Один обмен у торговца", tostring(f).." фрагментов за "..tostring(k).." убийств. Направление списания определяется игрой; проверь её табличку.") then
            return false, "Обмен отменён"
        end
        if self:Stat("Kills") ~= kills or self:Stat("Fragments") ~= fragments then
            return false, "Баланс изменился во время подтверждения; запусти обмен заново"
        end
        local currentText = {}
        for _, label in ipairs(descendants(detector.Parent)) do if isa(label,"TextLabel") then currentText[#currentText+1]=label.Text end end
        if table.concat(currentText," ") ~= text then return false, "Условия обмена изменились" end
        local sent, why = self:Interact(detector, token)
        if not sent and why ~= "Требуется ручной клик" then return false, why end
        local ok = self:Wait(token, 12, function()
            local a,b = self:Stat("Kills"), self:Stat("Fragments")
            return a ~= nil and b ~= nil and ((a-kills == k and b-fragments == -f) or (a-kills == -k and b-fragments == f))
        end)
        self.badgeRefreshAt = -1000
        if ok then return true, "Обмен подтверждён встречными изменениями обоих балансов" end
        return false, "Однозначного результата обмена нет. Автоповтора нет."
    end
    function C:Forge(token)
        local detector, state = self:Resolve("forge"), self:Resolve("forgeState")
        if not detector or not state then return false, "Кузница или её состояние не найдены" end
        local signTexts={}
        local main=detector.Parent and detector.Parent.Parent
        for _,label in ipairs(descendants(main)) do
            if isa(label,"TextLabel") then signTexts[#signTexts+1]=label.Text end
        end
        local terms=table.concat(signTexts," ")
        local alignmentCost=numericCost(terms:lower(),"kills")
        local fragmentRequirement=numericCost(terms:lower(),"fragments")
        if not alignmentCost or not fragmentRequirement then
            return false,"Текущие условия кузницы не читаются; расход не выполняется"
        end
        local function sameTerms()
            local fresh={}
            for _,label in ipairs(descendants(main))do if isa(label,"TextLabel")then fresh[#fresh+1]=label.Text end end
            return table.concat(fresh," ")==terms
        end
        local function flag(name) return positive(value(find(state,name))) end
        local owner = value(find(state,"Name1"))
        if owner and owner ~= "" and owner ~= self.player.Name and (flag("forging") or flag("aligning") or flag("aligned")) then
            return false, "Кузница уже занята другим игроком"
        end
        if flag("forging") then return false, "Ковка уже идёт; повторное нажатие заблокировано" end
        if not flag("aligned") then
            local kills = self:Stat("Kills")
            if not kills or kills < alignmentCost then return false, "Для выравнивания нужно убийств: "..alignmentCost end
            if flag("aligning") then return false, "Звезда уже выравнивается; дождись текущего этапа" end
            if not self:AskCost(token, "Выравнивание звезды", "По текущей табличке: "..alignmentCost.." убийств. После нажатия появляются противники. Это этап кузницы, а не мгновенная выдача оружия.") then
                return false, "Запуск кузницы отменён"
            end
            if flag("aligned") or flag("aligning") or flag("forging") then return false, "Состояние кузницы изменилось" end
            if (self:Stat("Kills") or -1)<alignmentCost or not sameTerms() then return false,"Баланс или условия кузницы изменились" end
            local sent, why = self:Interact(detector, token)
            if not sent and why ~= "Требуется ручной клик" then return false, why end
            self:Log("КУЗНИЦА", "Ожидаю выравнивание звезды. Боевой этап может потребовать участия игрока.")
            if not self:Wait(token, 120, function() return flag("aligned") end) then
                return false, "Выравнивание не подтверждено; повторного расхода не будет"
            end
        end
        local fragments = self:Stat("Fragments")
        if not fragments or fragments < fragmentRequirement then return false, "Звезда выровнена. Для следующего этапа нужно фрагментов: "..fragmentRequirement end
        if not self:AskCost(token, "Запуск ковки", "Требование текущей таблички: "..fragmentRequirement.." фрагментов и выровненная звезда. Один клик, затем проверка результата.") then
            return false, "Ковка отменена"
        end
        if not flag("aligned") or flag("forging") or (self:Stat("Fragments") or -1)<fragmentRequirement or not sameTerms() then
            return false, "Состояние или ресурсы кузницы изменились"
        end
        owner = value(find(state,"Name1"))
        if owner and owner ~= "" and owner ~= self.player.Name then return false,"Кузницу занял другой игрок" end
        local sent, why = self:Interact(detector, token)
        if not sent and why ~= "Требуется ручной клик" then return false, why end
        self:Log("КУЗНИЦА", "Нажатие отправлено. Проверяется реальный результат ковки.")
        -- Во время ковки нельзя уходить к стойке на спавне: это может сорвать этап.
        local untilTime,nextTouch=self.clock()+self.settings.goalSeconds,0
        while self:Alive(token) and self.clock()<untilTime do
            if self:GoalSatisfied(self.items.storm)then return true,"Гром-секира или её бейдж подтверждены"end
            local pickup=self:FindPickup(self.items.storm)
            local forgePart=self:PartOf(detector)
            local dropPart=self:PartOf(pickup)
            if pickup and dropPart and forgePart and (dropPart.Position-forgePart.Position).Magnitude<100 and self.clock()>nextTouch then
                self:Interact(pickup,token);nextTouch=self.clock()+2
            end
            self:Sleep(token,0.2)
        end
        return false,"Результат ковки не подтверждён. Повторного нажатия или ухода к стойке не было."
    end
    function C:World5Puzzle(token)
        local puzzle = self:Resolve("world5Puzzle")
        local scriptObject = find(find(puzzle,"Main"),"Script")
        if not scriptObject then return false, "Состояние загадки Мира 5 отсутствует" end
        local plan = {}
        for i=1,3 do
            local code = find(scriptObject,"Code"..i)
            local key = value(find(code,"Key"))
            if type(key) ~= "string" or key == "" then return false,"Текущий код не реплицирован клиенту" end
            local match
            for _, object in ipairs(descendants(puzzle)) do
                if object.Name=="TheCode" and value(object)==key then
                    local parent = object.Parent
                    local part = isa(parent,"BasePart") and parent or find(parent,"Main",true)
                    if part and isa(part,"BasePart") then
                        if match then return false,"Для символа найдены несколько плит; автоматический выбор остановлен" end
                        match=part
                    end
                end
            end
            if not match then return false,"Для символа «"..key.."» нет доступной плиты. Последовательность не угадывается." end
            plan[#plan+1]={code=code,key=key,part=match}
        end
        for i,step in ipairs(plan) do
            if value(find(step.code,"Key"))~=step.key then return false,"Код изменился; последовательность остановлена" end
            if not positive(value(find(step.code,"Active"))) then
                local sent, why=self:Interact(step.part,token)
                if not sent then return false,why end
                if not self:Wait(token,5,function()return positive(value(find(step.code,"Active")))end) then
                    return false,"Плита "..i.." не подтверждена состоянием игры"
                end
            end
        end
