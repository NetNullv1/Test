    function C:FetchPublicBadges()
        local request=E.request or E.http_request or (type(E.syn)=="table" and E.syn.request)
        if type(request)~="function" then return false,"Нет HTTP-функции: используется список бейджей из исходника игры" end
        local cursor=""
        for _=1,3 do
            if self.dead then return false,"Отменено" end
            local url="https://badges.roblox.com/v1/universes/"..catalog.universeId.."/badges?limit=100&sortOrder=Asc"
            if cursor~="" then url=url.."&cursor="..self.http:UrlEncode(cursor)end
            local ok,response=pcall(request,{Url=url,Method="GET",Timeout=15})
            if self.dead then return false,"Отменено" end
            if not ok or type(response)~="table" or tonumber(response.StatusCode)~=200 or type(response.Body)~="string" then
                return false,"Каталог бейджей по HTTP недоступен; используется резервный список"
            end
            if #response.Body>2000000 then return false,"Ответ каталога слишком большой" end
            local decoded,payload=pcall(function()return self.http:JSONDecode(response.Body)end)
            if not decoded or type(payload)~="table" or type(payload.data)~="table" then return false,"Некорректный ответ каталога" end
            for _,record in ipairs(payload.data)do
                local id=tonumber(record.id)
                if id and id>0 and id%1==0 and id<9007199254740992 and type(record.name)=="string" then
                    if not self.badges[id]then self.badges[id]={id=id,owned=nil};self.badgeOrder[#self.badgeOrder+1]=id end
                    self.badges[id].name=record.name
                    self.badges[id].enabled=record.enabled
                end
            end
            cursor=payload.nextPageCursor or ""
            if cursor=="" then return true end
        end
        return true,"Каталог ограничен тремя страницами"
    end
    function C:RefreshBadges()
        if self.badgeBusy or self.dead then return end
        self.badgeBusy=true
        local success,err=pcall(function()
            if not self.catalogLoaded then
                self.catalogLoaded=true
                local ok,why=self:FetchPublicBadges()
                if not ok then self:Log("БЕЙДЖИ",why)end
            end
            for _,id in ipairs(self.badgeOrder)do
                if self.dead then return end
                local record=self.badges[id]
                if not record.name then
                    local ok,info=pcall(function()return self.badgeService:GetBadgeInfoAsync(id)end)
                    if self.dead then return end
                    if ok and type(info)=="table" and type(info.Name)=="string" then
                        record.name,record.enabled=info.Name,info.IsEnabled
                    end
                    self.task.wait(0.3)
                end
            end
            for offset=1,#self.badgeOrder,10 do
                if self.dead then return end
                local batch={}
                for i=offset,math.min(offset+9,#self.badgeOrder)do batch[#batch+1]=self.badgeOrder[i]end
                local ok,owned=pcall(function()return self.badgeService:CheckUserBadgesAsync(self.player.UserId,batch)end)
                if self.dead then return end
                if ok and type(owned)=="table" then
                    local positiveIDs={}
                    for _,id in ipairs(owned)do positiveIDs[tonumber(id)]=true end
                    for _,id in ipairs(batch)do
                        if positiveIDs[id]then self.badges[id].owned=true
                        elseif self.badges[id].owned~=true then self.badges[id].owned=false end
                    end
                else self:Log("БЕЙДЖИ","Проверка владения временно недоступна. Неизвестный статус не считается отсутствием.","badges_error",30)end
                self.task.wait(0.3)
            end
        end)
        self.badgeBusy=false
        self.badgeRefreshAt=self.clock()
        if not success then self:Log("ОШИБКА","Проверка бейджей: "..tostring(err),"badge_exception",20)end
    end
    function C:Diagnostics()
