local createController = (function()
-- Lumynia / Танос. Контроллер RC2. Выполнение на клиенте, без подмены наград.
return function(E, catalog)
    local C = {}
    C.__index = C
    local function normal(s)
        return (tostring(s or ""):lower():gsub("[%s%p]", ""))
    end
    local function positive(v)
        return v == true or (type(v) == "number" and v > 0)
    end
    local function value(o)
        if not o then return nil end
        local ok, v = pcall(function() return o.Value end)
        return ok and v or nil
    end
    local function children(o)
        return o and o:GetChildren() or {}
    end
    local function descendants(o)
        return o and o:GetDescendants() or {}
    end
    local function isa(o, class)
        return o ~= nil and o:IsA(class)
    end
    local function find(o, name, recursive)
        return o and o:FindFirstChild(name, recursive == true) or nil
    end
    local function matches(name, aliases)
        local n = normal(name)
        for _, alias in ipairs(aliases or {}) do
            if n == normal(alias) then return true end
        end
        return false
    end
    local function numericCost(text, unit)
        local result
        -- Только число непосредственно перед указанной валютой.
        for digits in tostring(text):gmatch("([%d][%d,%. ]*)%s+" .. unit) do
            local n = tonumber((digits:gsub("[,%. ]", "")))
            if n and n >= 0 and n <= 1e12 then
                if result and result ~= n then return nil end
                result = n
            end
        end
        return result
    end
    function C.new()
        local self = setmetatable({}, C)
        self.env, self.catalog = E, catalog
        self.game = assert(E.game, "Объект игры недоступен")
        self.players = self.game:GetService("Players")
        self.player = assert(self.players.LocalPlayer, "Локальный игрок ещё не создан")
        self.world = self.game:GetService("Workspace")
        self.lighting = self.game:GetService("Lighting")
        self.badgeService = self.game:GetService("BadgeService")
        self.http = self.game:GetService("HttpService")
        self.runService = self.game:GetService("RunService")
        self.input = self.game:GetService("UserInputService")
        self.task = E.task
        self.clock = E.os.clock
        self.dead, self.epoch, self.sequence = false, 0, 0
        self.connections, self.logs, self.bridge = {}, {}, {}
        self.items, self.badges, self.badgeOrder = {}, {}, {}
        self.goalStates, self.worldPickups = {}, {}
        self.enemyCache, self.enemySkip = {}, setmetatable({}, {__mode="k"})
        self.scanAt, self.lastAttack, self.lastMove = -100, -100, -100
        self.lastLog, self.badgeRefreshAt = {}, -1000
        self.settings = {attackInterval=0.30, distance=4.2, npcFilter=1, goalSeconds=180, dropSeconds=900, follow=true}
        self.farmFilters = {"Все подходящие NPC", "Обычные NPC", "NPC 2.0", "Слуги небожителя", "Лазарь"}
        self.allowed = tonumber(self.game.GameId) == catalog.universeId or tonumber(self.game.PlaceId) == catalog.placeId
        for _, item in ipairs(catalog.items) do self.items[item.id] = item end
        for _, id in ipairs(catalog.badgeSeeds) do
            self.badges[id] = {id=id, owned=nil}
            self.badgeOrder[#self.badgeOrder+1] = id
        end
        self.aliasIndex = {}
        for _, item in ipairs(catalog.items) do
            for _, name in ipairs(item.tools or {}) do self.aliasIndex[normal(name)] = item.id end
        end
        self.capabilities = {
            touch = type(E.firetouchinterest) == "function",
            click = type(E.fireclickdetector) == "function",
            prompt = type(E.fireproximityprompt) == "function",
            files = type(E.writefile) == "function",
            http = type(E.request) == "function" or type(E.http_request) == "function" or
                   (type(E.syn) == "table" and type(E.syn.request) == "function"),
        }
        return self
    end
    function C:Connect(signal, fn)
        local connection = signal:Connect(function(...)
            if self.dead then return end
            local ok, err = pcall(fn, ...)
            if not ok then self:Log("ОШИБКА", tostring(err), "signal", 3) end
        end)
        self.connections[#self.connections+1] = connection
        return connection
    end
    function C:Log(kind, text, throttleKey, seconds)
        if self.dead then return end
        local now = self.clock()
        if throttleKey then
            if now - (self.lastLog[throttleKey] or -math.huge) < (seconds or 2) then return end
            self.lastLog[throttleKey] = now
        end
        local line = string.format("[%s] %s", kind, tostring(text))
        self.logs[#self.logs+1] = line
        if #self.logs > 240 then table.remove(self.logs, 1) end
        self.status = text
        if self.onLog then pcall(self.onLog, line) end
        if kind == "ОШИБКА" or kind == "СТОП" then (E.warn or E.print)("[Танос RC2] " .. line) end
    end
    function C:Resolve(path)
        if type(path) == "string" then path = catalog.paths[path] end
        if type(path) ~= "table" then return nil end
        local o = self.game
        for _, segment in ipairs(path) do
            if segment == "Workspace" and o == self.game then o = self.world
            else o = find(o, segment) end
            if not o then return nil end
        end
        return o
    end
    function C:Alive(token)
        return not self.dead and (token == nil or token == self.epoch)
    end
    function C:Sleep(token, duration)
        local untilTime = self.clock() + duration
        repeat
            if not self:Alive(token) then return false end
            local left = untilTime - self.clock()
            if left <= 0 then break end
            self.task.wait(math.min(0.1, left))
        until false
        return self:Alive(token)
    end
    function C:Wait(token, timeout, predicate)
        local untilTime = self.clock() + timeout
        repeat
            if not self:Alive(token) then return false, "Отменено" end
            local ok, result = pcall(predicate)
            if ok and result == true then return true end
            if not self:Sleep(token, 0.15) then return false, "Отменено" end
        until self.clock() >= untilTime
        return false, "Истекло время ожидания"
    end
    function C:Character()
        local character = self.player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = find(character, "HumanoidRootPart")
        if not character or not humanoid or humanoid.Health <= 0 or not root or not root.Parent then return nil end
        return character, humanoid, root
    end
    function C:Tools()
        local result, seen = {}, {}
        local holders = {[1]=find(self.player, "Backpack"), [2]=self.player.Character}
        for index=1,2 do
            local holder=holders[index]
            for _, tool in ipairs(children(holder)) do
                if isa(tool, "Tool") and not seen[tool] then
                    result[#result+1], seen[tool] = tool, true
                end
            end
        end
        return result
    end
    function C:ToolNames()
        local names, seen = {}, {}
        for _, tool in ipairs(self:Tools()) do
            if not seen[tool.Name] then names[#names+1], seen[tool.Name] = tool.Name, true end
        end
        table.sort(names)
        return names
    end
    function C:FindTool(item)
        if type(item) == "string" then item = self.items[item] end
        if not item then return nil end
        for _, tool in ipairs(self:Tools()) do
            if matches(tool.Name, item.tools) then return tool end
        end
        return nil
    end
    function C:ItemEvidence(item)
        if item.upgradeOf then
            local tool = self:FindTool(item.upgradeOf)
            if positive(value(find(tool, "Pack-A-Punch"))) then return true, "Флаг улучшения оружия" end
            return false
        end
        if self:FindTool(item) then return true, "Предмет у персонажа" end
        if item.stone then
            local gauntlet = self:FindTool("gauntlet")
            local stone = find(find(gauntlet, "Stones"), item.stone)
            if positive(value(stone)) then return true, "Камень установлен в перчатке" end
        end
        -- Только точные названия и явно истинное числовое/логическое значение.
        local inventory = find(self.player, "Inventory")
        for _, entry in ipairs(children(inventory)) do
            if matches(entry.Name, item.tools) and positive(value(entry)) then return true, "Запись инвентаря" end
        end
        return false
    end
    function C:BadgeStatus(item)
        local known, unknown = false, false
        for _, record in pairs(self.badges) do
            if record.name and matches(record.name, item.badgeNames) then
                if record.owned == true then return true, record.id end
                if record.owned == false then known = true else unknown = true end
            end
        end
        if known and not unknown then return false end
        return nil
    end
    function C:GoalSatisfied(item)
        if self:ItemEvidence(item) then return true, "предмет подтверждён" end
        if self:BadgeStatus(item) == true then return true, "бейдж подтверждён" end
        return false
    end
    function C:Stat(name)
        local roots = {[1]=find(self.player,"leaderstats"),[2]=find(self.player,"Stats"),[3]=self.player}
        for index=1,3 do
            local root=roots[index]
            local stat = find(root, name)
            local v = value(stat)
            if type(v) == "number" then return v end
        end
        return nil
    end
    function C:Move(position, token, face)
        if not self.allowed or not self:Alive(token) then return false, "Перемещение отменено" end
        local _, humanoid, root = self:Character()
        if not root then return false, "Ожидание возрождения персонажа" end
        local target
        if E.typeof(position) == "CFrame" then target = position
        elseif E.typeof(position) == "Vector3" then
            target = face and E.CFrame.new(position, face) or E.CFrame.new(position)
        else return false, "Некорректная точка перемещения" end
        local p = target.Position
        if p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z or math.abs(p.X)+math.abs(p.Y)+math.abs(p.Z)>1e7 then
            return false, "Небезопасные координаты"
        end
        if humanoid.SeatPart then humanoid.Sit = false end
        root.AssemblyLinearVelocity = E.Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = E.Vector3.new(0, 0, 0)
        root.CFrame = target
        return true
    end
    function C:PartOf(o)
        local current = o
        while current and current ~= self.world do
            if isa(current, "BasePart") then return current end
            if isa(current, "Attachment") then current = current.Parent
            elseif isa(current, "Model") or isa(current, "Tool") then
                return (isa(current,"Model") and current.PrimaryPart) or find(current, "Handle", true) or current:FindFirstChildWhichIsA("BasePart", true)
            else current = current.Parent end
        end
        return nil
    end
    function C:Interact(o, token)
        if not o or not o.Parent then return false, "Объект не появился или уже исчез" end
        if not self.allowed or not self:Alive(token) then return false, "Отменено" end
        local part = self:PartOf(o)
        if not part then return false, "Нет физической точки взаимодействия" end
        local moved, why = self:Move(part.Position + E.Vector3.new(0, 2.5, 3), token)
        if not moved then return false, why end
        if not self:Sleep(token, 0.25) then return false, "Отменено" end
        local _, _, root = self:Character()
        if not root or not o.Parent then return false, "Персонаж или объект изменился" end
        local range = isa(o,"ClickDetector") and (tonumber(o.MaxActivationDistance) or 32)
            or isa(o,"ProximityPrompt") and (tonumber(o.MaxActivationDistance) or 10) or 8
        if range <= 0 then return false,"Взаимодействие выключено игрой" end
        if (root.Position-part.Position).Magnitude > range+0.5 then
            return false,"Перемещение не удержалось или объект вне радиуса взаимодействия"
        end
        if isa(o, "ClickDetector") then
            if not self.capabilities.click then
                self:Log("ВРУЧНУЮ", "Нажми кнопку рядом с персонажем: исполнитель не поддерживает программный клик.")
