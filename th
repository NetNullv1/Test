        self:Log("СОБЫТИЕ", "Эмблема УВИ активирована касанием. Проверяю появившиеся дубинку и Темпад; прохождение дверей не подменяется.")
        local untilTime=self.clock()+self.settings.goalSeconds
        local nextTouch=0
        while self:Alive(token) and self.clock()<untilTime do
            local both=true
            for _,id in ipairs({"time_stick","tempad"}) do
                local item=self.items[id]
                if not self:GoalSatisfied(item) then
                    both=false
                    local pickup=self:FindPickup(item)
                    if pickup and self.clock()>nextTouch then self:Interact(pickup,token);nextTouch=self.clock()+2 end
                end
            end
            if both then return true,"Оба предмета или их бейджи подтверждены" end
            self:Sleep(token,0.2)
        end
        return false,"Событие запущено, но получение обоих предметов не подтверждено"
    end
    function C:FindRound()
        for _,root in ipairs({self.world,self.game:GetService("ReplicatedStorage")}) do
            for _,object in ipairs(descendants(root)) do
                if object.Name=="Round" or object.Name=="Wave" or object.Name=="CurrentRound" or object.Name=="CurrentWave" then
                    if type(value(object))=="number" then
                        local depth,parent=0,object.Parent
                        while parent and parent~=root and depth<4 do depth=depth+1;parent=parent.Parent end
                        if parent==root and depth<=3 then return object end
                    end
                end
            end
        end
        return nil
    end
    function C:Rounds(token)
        local round=self:FindRound()
        if not round then return false,"Счётчик волн не найден. Сначала вручную запусти нужный режим через меню игры." end
        local untilTime=self.clock()+1800
        while self:Alive(token) and self.clock()<untilTime do
            if self:BadgeStatus(self.items.round100)==true then return true,"Бейдж 100-го раунда подтверждён" end
            if not round.Parent then return false,"Счётчик волн исчез: режим завершён или плейс сменился" end
            local n=value(round)
            self:Log("ВОЛНЫ","Текущий раунд: "..tostring(n)..". Условие бейджа проверяется отдельно.","round",10)
            self:CombatStep(token)
            self:Sleep(token,0.15)
