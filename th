        return false,"Бейдж 100-го раунда за время работы не подтверждён"
    end
    function C:RunGoal(item, token)
        if self:GoalSatisfied(item) and item.mode~="claim" then return true,"Уже подтверждено" end
        if item.mode=="claim" then return self:Claim(item,token) end
        if item.mode=="pickup" or item.mode=="drop" or item.mode=="watch" then return self:CollectGoal(item,token) end
        if item.mode=="upgrade" then return self:Upgrade(item,token) end
        if item.mode=="stones" then
            if not self:FindTool("gauntlet") then
                local ok,why=self:Claim(self.items.gauntlet,token)
                if not ok then return false,why end
            end
            for _,id in ipairs({"space","time","reality","mind","power","soul"}) do
                local ok,why=self:CollectGoal(self.items[id],token,true)
                if not ok then return false,self.items[id].name..": "..why end
            end
            self:EquipFor(self.items.gauntlet,token)
            self.badgeRefreshAt=-1000
            local ok=self:Wait(token,20,function()return self:BadgeStatus(item)==true end)
            return ok,ok and "Бейдж «Я неизбежен» подтверждён" or "Камни найдены; проверь их установку в перчатке. Выдача бейджа ещё не подтверждена."
        end
        if item.mode=="world5" then
            local sent,why=self:Interact(self:Resolve("world5"),token)
            if not sent and why~="Требуется ручной клик" then return false,why end
            self.badgeRefreshAt=-1000
            local ok=self:Wait(token,25,function()return self:BadgeStatus(item)==true end)
            return ok,ok and "Бейдж Мира 5 подтверждён" or "Вход активирован; бейдж Мира 5 не подтверждён"
        end
        if item.mode=="rounds" then return self:Rounds(token) end
        if item.mode=="creator" then
            if tostring(self.game.CreatorType)~="Enum.CreatorType.User" then
                return false,"Создатель опыта не является личным аккаунтом; условие встречи не выводится из владельца группы"
            end
            local creator=self.players:GetPlayerByUserId(self.game.CreatorId)
            if not creator then return false,"Настоящего создателя сейчас нет на этом сервере" end
            self.badgeRefreshAt=-1000
            local ok=self:Wait(token,20,function()return self:BadgeStatus(item)==true end)
            return ok,ok and "Бейдж встречи подтверждён" or "Создатель на сервере, но выдача бейджа ещё не подтверждена"
        end
        self.badgeRefreshAt=-1000
        local ok=self:Wait(token,15,function()return self:BadgeStatus(item)==true end)
        return ok,ok and "Бейдж подтверждён" or "Бейдж не подтверждён или его идентификатор пока не найден"
    end
