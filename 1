    Write-Host $Text
}

function Test-IsAdministrator {
    try {
        $id = [Security.Principal.WindowsIdentity]::GetCurrent()
        $p  = New-Object Security.Principal.WindowsPrincipal($id)
        return $p.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    } catch { return $false }
}

function Test-IPv4([string]$Ip) {
    $obj = $null
    if (-not [Net.IPAddress]::TryParse($Ip, [ref]$obj)) { return $false }
    return $obj.AddressFamily -eq [Net.Sockets.AddressFamily]::InterNetwork
}

function Test-PrivateIPv4([string]$Ip) {
    try {
        $b = [Net.IPAddress]::Parse($Ip).GetAddressBytes()
        if ($b[0] -eq 10) { return $true }
        if ($b[0] -eq 172 -and $b[1] -ge 16 -and $b[1] -le 31) { return $true }
        if ($b[0] -eq 192 -and $b[1] -eq 168) { return $true }
        return $false
    } catch { return $false }
}

function Convert-IPv4ToUInt64([string]$Ip) {
    $b = [Net.IPAddress]::Parse($Ip).GetAddressBytes()
    [Array]::Reverse($b)
    return [uint64][BitConverter]::ToUInt32($b,0)
}
function Convert-UInt64ToIPv4([uint64]$N) {
    $b = [BitConverter]::GetBytes([uint32]$N)
    [Array]::Reverse($b)
    return ([Net.IPAddress]::new([byte[]]$b)).ToString()
}

function Get-SubnetInfo([string]$Ip, [int]$PrefixLength) {
    if ($PrefixLength -lt 0 -or $PrefixLength -gt 32) { throw 'Invalid IPv4 prefix length' }
    $ipn = Convert-IPv4ToUInt64 $Ip
    if ($PrefixLength -eq 0) { $mask = [uint64]0 }
    else { $mask = (([uint64]0xFFFFFFFF) -shl (32 - $PrefixLength)) -band [uint64]0xFFFFFFFF }
    $network = $ipn -band $mask
    $total = [uint64][Math]::Pow(2, (32 - $PrefixLength))
    $broadcast = $network + $total - 1
    if ($PrefixLength -le 30) {
        $first = $network + 1
        $last  = $broadcast - 1
        $usable = $total - 2
    } elseif ($PrefixLength -eq 31) {
        $first = $network
        $last = $broadcast
        $usable = 2
    } else {
        $first = $network
        $last = $network
        $usable = 1
    }
    [pscustomobject]@{
        IP             = $Ip
        PrefixLength   = $PrefixLength
        Network        = Convert-UInt64ToIPv4 $network
        Broadcast      = Convert-UInt64ToIPv4 $broadcast
        FirstHostInt   = [uint64]$first
        LastHostInt    = [uint64]$last
        UsableHosts    = [uint64]$usable
    }
}

function Get-IPv4AddressList($Subnet) {
    $list = New-Object 'System.Collections.Generic.List[string]'
    for ([uint64]$n = $Subnet.FirstHostInt; $n -le $Subnet.LastHostInt; $n++) {
        [void]$list.Add((Convert-UInt64ToIPv4 $n))
    }
    return @($list)
}

function Get-PublicIPv4 {
    $urls = @('https://api.ipify.org','https://ipv4.icanhazip.com','https://v4.ident.me')
    foreach ($u in $urls) {
        try {
            $v = (Invoke-RestMethod -Uri $u -Method Get -TimeoutSec 4).ToString().Trim()
            if (Test-IPv4 $v) { return $v }
        } catch {}
    }
    return ''
}

function Resolve-PtrName([string]$Ip) {
    try {
        $r = Resolve-DnsName -Name $Ip -Type PTR -QuickTimeout -ErrorAction Stop |
            Where-Object { $_.Type -eq 'PTR' } | Select-Object -First 1
        if ($r -and $r.NameHost) { return $r.NameHost.TrimEnd('.') }
    } catch {}
    return ''
}

function Invoke-PingSweep {
    param([string[]]$Addresses, [int]$TimeoutMs, [int]$Throttle)
    $Addresses = @($Addresses)
    $results = New-Object 'System.Collections.Generic.List[object]'
    if ($Addresses.Count -eq 0) { return @() }

    $pool = [System.Management.Automation.Runspaces.RunspaceFactory]::CreateRunspacePool(1, $Throttle)
    $pool.Open()
    $workerCode = @'
param($ip,$timeout)
$p = New-Object System.Net.NetworkInformation.Ping
try {
    $r = $p.Send($ip,$timeout)
    if ($r.Status -eq [System.Net.NetworkInformation.IPStatus]::Success) {
        [pscustomobject]@{ IP=$ip; LatencyMs=[int]$r.RoundtripTime; Status='Alive' }
    }
} catch {} finally { $p.Dispose() }
'@
    try {
        $chunkSize = 512
        $done = 0
        for ($base = 0; $base -lt $Addresses.Count; $base += $chunkSize) {
            $end = [Math]::Min($base + $chunkSize - 1, $Addresses.Count - 1)
            $jobs = New-Object 'System.Collections.Generic.List[object]'
            for ($i = $base; $i -le $end; $i++) {
                $ps = [PowerShell]::Create()
                $ps.RunspacePool = $pool
                [void]$ps.AddScript($workerCode).AddArgument($Addresses[$i]).AddArgument($TimeoutMs)
                $h = $ps.BeginInvoke()
                [void]$jobs.Add([pscustomobject]@{ PowerShell=$ps; Handle=$h })
            }
            foreach ($j in $jobs) {
                try {
                    $out = $j.PowerShell.EndInvoke($j.Handle)
                    foreach ($x in @($out)) { if ($x) { [void]$results.Add($x) } }
                } catch {} finally { $j.PowerShell.Dispose() }
                $done++
            }
            $pc = [int](100 * $done / $Addresses.Count)
            Write-Progress -Activity 'IPv4 discovery' -Status "$done / $($Addresses.Count)" -PercentComplete $pc
        }
    } finally {
        Write-Progress -Activity 'IPv4 discovery' -Completed
        $pool.Close(); $pool.Dispose()
    }
    return @($results)
}

function Invoke-TcpScan {
    param(
        [string[]]$Targets,
        [int[]]$Ports,
        [int]$TimeoutMs,
        [int]$Throttle,
        [string]$Activity = 'TCP port scan'
    )
    $Targets = @($Targets)
    $Ports = @($Ports)
    $results = New-Object 'System.Collections.Generic.List[object]'
    if ($Targets.Count -eq 0 -or $Ports.Count -eq 0) { return @() }

    $total = [int64]$Targets.Count * [int64]$Ports.Count
    $pool = [System.Management.Automation.Runspaces.RunspaceFactory]::CreateRunspacePool(1, $Throttle)
    $pool.Open()
    $workerCode = @'
param($ip,$port,$timeout)
$c = New-Object System.Net.Sockets.TcpClient
$sw = [Diagnostics.Stopwatch]::StartNew()
try {
    $ar = $c.BeginConnect($ip,[int]$port,$null,$null)
    $ok = $ar.AsyncWaitHandle.WaitOne($timeout,$false)
    if ($ok) {
        try { $c.EndConnect($ar) } catch {}
        if ($c.Connected) {
            $sw.Stop()
            [pscustomobject]@{ IP=$ip; Port=[int]$port; ConnectMs=[int]$sw.ElapsedMilliseconds; State='OPEN' }
        }
    }
    try { $ar.AsyncWaitHandle.Close() } catch {}
} catch {} finally { $c.Close(); $sw.Stop() }
'@
    try {
        $chunkSize = 512
        $jobs = New-Object 'System.Collections.Generic.List[object]'
        [int64]$queued = 0
        [int64]$done = 0

        foreach ($ip in $Targets) {
            foreach ($port in $Ports) {
                $ps = [PowerShell]::Create()
                $ps.RunspacePool = $pool
                [void]$ps.AddScript($workerCode).AddArgument($ip).AddArgument([int]$port).AddArgument($TimeoutMs)
                $h = $ps.BeginInvoke()
                [void]$jobs.Add([pscustomobject]@{ PowerShell=$ps; Handle=$h })
                $queued++

                if ($jobs.Count -ge $chunkSize -or $queued -eq $total) {
                    foreach ($j in $jobs) {
                        try {
                            $out = $j.PowerShell.EndInvoke($j.Handle)
                            foreach ($x in @($out)) { if ($x) { [void]$results.Add($x) } }
                        } catch {} finally { $j.PowerShell.Dispose() }
                        $done++
                    }
                    $jobs.Clear()
                    $pc = [int](100 * $done / $total)
                    Write-Progress -Activity $Activity -Status "$done / $total   open: $($results.Count)" -PercentComplete $pc
                }
            }
        }
    } finally {
        Write-Progress -Activity $Activity -Completed
        $pool.Close(); $pool.Dispose()
    }
    return @($results)
}

function Get-PortService([int]$Port) {
    if ($ServiceMap.ContainsKey($Port)) { return $ServiceMap[$Port] }
    return ''
}

function Save-RawCommand([string]$Command, [string]$Path) {
    try { cmd.exe /d /c $Command 2>&1 | Out-File -FilePath $Path -Encoding utf8 -Width 4096 } catch {}
}

