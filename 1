function Write-Line([string]$Text = '', [ConsoleColor]$Color = [ConsoleColor]::Gray) {
    Write-Host $Text -ForegroundColor $Color
}
function Write-Section([string]$Text) {
    Write-Host ''
    Write-Host ('  ┌─ ' + $Text) -ForegroundColor Cyan
    Write-Host ('  ' + ('─' * ([Math]::Min(90, [Math]::Max(8, $Text.Length + 4))))) -ForegroundColor DarkCyan
}
function Write-Ok([string]$Text)   { Write-Host ('  [+] ' + $Text) -ForegroundColor Green }
function Write-Warn([string]$Text) { Write-Host ('  [!] ' + $Text) -ForegroundColor Yellow }
function Write-Err([string]$Text)  { Write-Host ('  [x] ' + $Text) -ForegroundColor Red }
function Write-Info([string]$Text) { Write-Host ('  [i] ' + $Text) -ForegroundColor Gray }
function Write-ReportBlock([string]$Text, [string]$Path) {
