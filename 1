@echo off
setlocal EnableExtensions EnableDelayedExpansion
title IPv4 Network Audit - Win10 SAFE
color 0A

rem ASCII-only BAT for maximum Windows 10 cmd.exe compatibility.
rem No admin, no UAC, no PowerShell script generation tricks.

set "BASE=%USERPROFILE%\Desktop"
if not exist "%BASE%" set "BASE=%TEMP%"
set "OUT=%BASE%\IPv4_Audit_%COMPUTERNAME%"
if not exist "%OUT%" mkdir "%OUT%" 2>nul

echo ============================================================
echo IPv4 NETWORK AUDIT - WIN10 SAFE - NO ADMIN
echo ============================================================
echo Output: %OUT%
echo.

rem Prove write access before doing anything else.
echo Audit started %DATE% %TIME%> "%OUT%\00_STARTED.txt"
if not exist "%OUT%\00_STARTED.txt" (
  echo ERROR: Cannot write to "%OUT%"
  echo Trying TEMP...
  set "OUT=%TEMP%\IPv4_Audit_%COMPUTERNAME%"
  if not exist "!OUT!" mkdir "!OUT!" 2>nul
  echo Audit started %DATE% %TIME%> "!OUT!\00_STARTED.txt"
)
if not exist "%OUT%\00_STARTED.txt" if exist "!OUT!\00_STARTED.txt" set "OUT=!OUT!"

echo [1/8] Basic Windows network information...
ipconfig /all > "%OUT%\01_ipconfig_all.txt" 2>&1
route print -4 > "%OUT%\02_routes_ipv4.txt" 2>&1
arp -a > "%OUT%\03_arp_before.txt" 2>&1
netstat -ano > "%OUT%\04_netstat_ano.txt" 2>&1
getmac /v /fo csv > "%OUT%\05_getmac.csv" 2>&1

echo [2/8] Detecting IPv4 and gateway...
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='SilentlyContinue'; Get-CimInstance Win32_NetworkAdapterConfiguration | ? IPEnabled | %% { $a=$_; @($_.IPAddress) | ? {$_ -match '^\d+\.\d+\.\d+\.\d+$'} | %% { [pscustomobject]@{Adapter=$a.Description;IPv4=$_;Mask=@($a.IPSubnet)[0];Gateway=@($a.DefaultIPGateway)[0];DNS=($a.DNSServerSearchOrder -join ',');MAC=$a.MACAddress;DHCP=$a.DHCPEnabled} } } | Export-Csv -NoTypeInformation -Encoding UTF8 '%OUT%\06_interfaces.csv'" > "%OUT%\06_interfaces_console.txt" 2>&1

echo [3/8] Detecting public IPv4...
powershell.exe -NoLogo -NoProfile -Command "$ProgressPreference='SilentlyContinue';try{(Invoke-WebRequest -UseBasicParsing -TimeoutSec 5 'https://api.ipify.org').Content.Trim()}catch{'UNAVAILABLE'}" > "%OUT%\07_public_ipv4.txt" 2>&1

echo [4/8] Detecting private LAN IPv4...
set "LANIP="
for /f "usebackq delims=" %%I in (`powershell.exe -NoLogo -NoProfile -Command "$x=Get-CimInstance Win32_NetworkAdapterConfiguration|? IPEnabled|%% {$_.IPAddress}|? {$_ -match '^10\.' -or $_ -match '^192\.168\.' -or $_ -match '^172\.(1[6-9]|2[0-9]|3[01])\.'}|select -First 1; if($x){$x}" 2^>nul`) do set "LANIP=%%I"

echo LAN IPv4: %LANIP%> "%OUT%\08_lan.txt"

if not defined LANIP (
  echo No private RFC1918 IPv4 found. LAN sweep skipped.>> "%OUT%\08_lan.txt"
  goto AFTERSWEEP
)

for /f "tokens=1-4 delims=." %%a in ("%LANIP%") do set "NET=%%a.%%b.%%c"

echo [5/8] Pinging %NET%.1 - %NET%.254...
echo IP,STATUS> "%OUT%\09_ping_sweep.csv"
for /L %%H in (1,1,254) do (
  ping -n 1 -w 120 %NET%.%%H | find "TTL=" >nul
  if not errorlevel 1 (
    echo %NET%.%%H,UP>> "%OUT%\09_ping_sweep.csv"
    echo   UP  %NET%.%%H
  )
)

arp -a > "%OUT%\10_arp_after.txt" 2>&1

echo [6/8] Resolving names...
powershell.exe -NoLogo -NoProfile -Command "$f='%OUT%\09_ping_sweep.csv';if(Test-Path $f){Import-Csv $f|%%{$ip=$_.IP;$n='';try{$n=[Net.Dns]::GetHostEntry($ip).HostName}catch{};[pscustomobject]@{IP=$ip;Hostname=$n;Status=$_.STATUS}}|Export-Csv -NoTypeInformation -Encoding UTF8 '%OUT%\11_hosts.csv'}" > "%OUT%\11_hosts_console.txt" 2>&1

echo [7/8] Scanning common TCP ports...
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='SilentlyContinue';$ports=21,22,23,25,53,80,110,135,139,143,443,445,554,587,631,993,995,1433,1883,3000,3306,3389,5000,5432,5555,5900,5985,5986,6379,8000,8080,8081,8443,8888,9000,9090,9100,9200,10000,25565,27017;$hf='%OUT%\09_ping_sweep.csv';$o=@();if(Test-Path $hf){$hs=Import-Csv $hf;foreach($h in $hs){foreach($p in $ports){$c=New-Object Net.Sockets.TcpClient;try{$a=$c.BeginConnect($h.IP,[int]$p,$null,$null);if($a.AsyncWaitHandle.WaitOne(120,$false)-and$c.Connected){$o+=[pscustomobject]@{IP=$h.IP;Port=$p;State='OPEN'}}catch{}finally{$c.Close()}}}};$o|Export-Csv -NoTypeInformation -Encoding UTF8 '%OUT%\12_open_ports.csv';'Open ports: '+$o.Count" > "%OUT%\12_ports_console.txt" 2>&1

:AFTERSWEEP
echo [8/8] Local listeners and connections...
powershell.exe -NoLogo -NoProfile -Command "try{Get-NetTCPConnection -State Listen|select LocalAddress,LocalPort,OwningProcess|sort LocalPort|Export-Csv -NoTypeInformation -Encoding UTF8 '%OUT%\13_local_listeners.csv'}catch{$_|Out-File '%OUT%\13_local_listeners_ERROR.txt'}" >nul 2>&1
powershell.exe -NoLogo -NoProfile -Command "try{Get-NetTCPConnection|? State -eq Established|select LocalAddress,LocalPort,RemoteAddress,RemotePort,OwningProcess|Export-Csv -NoTypeInformation -Encoding UTF8 '%OUT%\14_connections.csv'}catch{$_|Out-File '%OUT%\14_connections_ERROR.txt'}" >nul 2>&1

(
echo IPv4 NETWORK AUDIT
echo ==================
echo Computer: %COMPUTERNAME%
echo User: %USERNAME%
echo Date: %DATE% %TIME%
echo LAN IPv4: %LANIP%
echo.
echo Public IPv4:
type "%OUT%\07_public_ipv4.txt"
echo.
echo Output:
echo %OUT%
) > "%OUT%\00_SUMMARY.txt"

echo Audit completed %DATE% %TIME%> "%OUT%\99_FINISHED.txt"

echo.
echo ============================================================
echo DONE
echo ============================================================
echo Results:
echo %OUT%
echo.
dir /b "%OUT%"
echo.
start "" explorer.exe "%OUT%"
pause
exit /b 0