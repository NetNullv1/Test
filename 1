Clear-Host
Write-Host '╔══════════════════════════════════════════════════════════════════════════════╗' -ForegroundColor Cyan
Write-Host '║                       IPv4 NETWORK AUDIT • WINDOWS 10                      ║' -ForegroundColor Cyan
Write-Host '║                inventory • discovery • ports • firewall • report          ║' -ForegroundColor DarkCyan
Write-Host '╚══════════════════════════════════════════════════════════════════════════════╝' -ForegroundColor Cyan

if (-not (Test-IsAdministrator)) {
    Write-Warn 'Для полного списка процессов/портов нужны права администратора. Запрашиваю UAC.'
    try {
        $arg = '/c ""' + $env:NETAUDIT_SELF + '""'
        Start-Process -FilePath $env:ComSpec -ArgumentList $arg -Verb RunAs -ErrorAction Stop
        exit 77
    } catch {
        Write-Warn 'UAC отклонён. Продолжаю без повышения прав, часть данных может быть недоступна.'
    }
}

$stamp = Get-Date -Format 'yyyy-MM-dd_HH-mm-ss'
$desktop = [Environment]::GetFolderPath('Desktop')
if (-not $desktop) { $desktop = $env:TEMP }
$OutDir = Join-Path $desktop ("IPv4_Audit_" + $stamp)
New-Item -Path $OutDir -ItemType Directory -Force | Out-Null
$TextReport = Join-Path $OutDir 'REPORT.txt'
$HtmlReport = Join-Path $OutDir 'REPORT.html'

Write-Section 'Система'
$os = Get-CimInstance Win32_OperatingSystem
$cs = Get-CimInstance Win32_ComputerSystem
$SystemInfo = [pscustomobject]@{
    Computer       = $env:COMPUTERNAME
    User           = "$env:USERDOMAIN\$env:USERNAME"
    OS             = $os.Caption
    Version        = $os.Version
    Build          = $os.BuildNumber
    Architecture   = $os.OSArchitecture
    LastBoot       = $os.LastBootUpTime
    Manufacturer   = $cs.Manufacturer
    Model          = $cs.Model
    Admin          = (Test-IsAdministrator)
}
Write-ReportBlock (($SystemInfo | Format-List | Out-String)) $TextReport

Write-Section 'IPv4 интерфейсы'
$adapterRows = New-Object 'System.Collections.Generic.List[object]'
foreach ($a in @(Get-NetAdapter | Where-Object { $_.Status -eq 'Up' })) {
    $cfg = Get-NetIPConfiguration -InterfaceIndex $a.ifIndex
    $ips = @(Get-NetIPAddress -InterfaceIndex $a.ifIndex -AddressFamily IPv4 | Where-Object {
        $_.IPAddress -ne '127.0.0.1' -and $_.IPAddress -notlike '169.254.*'
    })
    $dns = @((Get-DnsClientServerAddress -InterfaceIndex $a.ifIndex -AddressFamily IPv4).ServerAddresses) -join ', '
    $dhcp = (Get-NetIPInterface -InterfaceIndex $a.ifIndex -AddressFamily IPv4).Dhcp
    foreach ($ip in $ips) {
        [void]$adapterRows.Add([pscustomobject]@{
            IfIndex       = $a.ifIndex
            Adapter       = $a.Name
            Description   = $a.InterfaceDescription
            IPv4          = $ip.IPAddress
            Prefix        = $ip.PrefixLength
            Gateway       = (@($cfg.IPv4DefaultGateway.NextHop) -join ', ')
            DNS           = $dns
            MAC           = $a.MacAddress
            LinkSpeed     = $a.LinkSpeed
            DHCP          = $dhcp
            Private       = (Test-PrivateIPv4 $ip.IPAddress)
        })
    }
}
$Adapters = @($adapterRows)
if ($Adapters.Count -eq 0) {
    Write-Err 'Не найден активный IPv4 интерфейс.'
    exit 2
}
Write-ReportBlock (($Adapters | Format-Table IfIndex,Adapter,IPv4,Prefix,Gateway,MAC,LinkSpeed,DHCP -AutoSize | Out-String)) $TextReport
$Adapters | Export-Csv (Join-Path $OutDir 'ADAPTERS.csv') -NoTypeInformation -Encoding UTF8

$defaultRoutes = @(Get-NetRoute -AddressFamily IPv4 -DestinationPrefix '0.0.0.0/0' |
    Where-Object { $_.NextHop -ne '0.0.0.0' } | Sort-Object RouteMetric)
$Primary = $null
foreach ($r in $defaultRoutes) {
    $Primary = $Adapters | Where-Object { $_.IfIndex -eq $r.ifIndex } | Select-Object -First 1
    if ($Primary) { break }
}
if (-not $Primary) { $Primary = $Adapters | Select-Object -First 1 }

$PublicIp = Get-PublicIPv4
if ($PublicIp) { Write-Ok "WAN/public IPv4: $PublicIp" } else { Write-Warn 'WAN/public IPv4 определить не удалось.' }
Write-Ok "Primary LAN IPv4: $($Primary.IPv4)/$($Primary.Prefix) [$($Primary.Adapter)]"
if ($Primary.Gateway) { Write-Info "Gateway: $($Primary.Gateway)" }

Write-Section 'Сырые диагностические снимки'
Save-RawCommand 'ipconfig /all' (Join-Path $OutDir 'IPCONFIG_ALL.txt')
Save-RawCommand 'route print -4' (Join-Path $OutDir 'ROUTE_PRINT_IPV4.txt')
Save-RawCommand 'arp -a' (Join-Path $OutDir 'ARP_A.txt')
Save-RawCommand 'netstat -ano' (Join-Path $OutDir 'NETSTAT_ANO.txt')
Save-RawCommand 'netsh advfirewall show allprofiles' (Join-Path $OutDir 'FIREWALL_PROFILES.txt')
Write-Ok 'ipconfig / route / arp / netstat / firewall сохранены.'

$Routes = @(Get-NetRoute -AddressFamily IPv4 | Select-Object InterfaceIndex,DestinationPrefix,NextHop,RouteMetric,State,PolicyStore)
$Routes | Export-Csv (Join-Path $OutDir 'ROUTES.csv') -NoTypeInformation -Encoding UTF8
$NeighborsBefore = @(Get-NetNeighbor -AddressFamily IPv4 | Select-Object ifIndex,IPAddress,LinkLayerAddress,State)
$NeighborsBefore | Export-Csv (Join-Path $OutDir 'NEIGHBORS_BEFORE.csv') -NoTypeInformation -Encoding UTF8

Write-Section 'Определение диапазона сканирования'
$scanSubnet = Get-SubnetInfo $Primary.IPv4 ([int]$Primary.Prefix)
$scanAllowed = $true
if (-not $Primary.Private) {
    Write-Warn "Интерфейс $($Primary.IPv4) не RFC1918. Автоматически соседний публичный диапазон не сканирую."
    Write-Info 'Будет проверен только этот IPv4. Это специально: чужой провайдерский /24 нам не нужен.'
    $scanSubnet = Get-SubnetInfo $Primary.IPv4 32
} elseif ($scanSubnet.UsableHosts -gt $Cfg.MaxAutomaticHosts) {
    Write-Warn "Подсеть $($scanSubnet.Network)/$($Primary.Prefix) содержит $($scanSubnet.UsableHosts) адресов."
    if ($scanSubnet.UsableHosts -le $Cfg.MaxFullSubnetHosts) {
        $choice = Read-Host "  Введите FULL для всей подсети или Enter для текущего /24"
    } else { $choice = '' }
    if ($choice -eq 'FULL') {
        Write-Warn 'Запущен полный sweep большой локальной подсети. Это может занять заметное время.'
    } else {
        $scanSubnet = Get-SubnetInfo $Primary.IPv4 24
        Write-Info "Ограничиваю автоматический sweep сегментом $($scanSubnet.Network)/24."
    }
}
Write-Ok "Диапазон: $($scanSubnet.Network)/$($scanSubnet.PrefixLength) • hosts: $($scanSubnet.UsableHosts)"

$Addresses = Get-IPv4AddressList $scanSubnet
Write-Section "ICMP discovery ($($Addresses.Count) IPv4)"
$PingResults = @(Invoke-PingSweep -Addresses $Addresses -TimeoutMs $Cfg.PingTimeoutMs -Throttle $Cfg.PingThrottle)
Write-Ok "ICMP ответили: $($PingResults.Count)"

# После sweep ARP/Neighbor таблица обычно становится намного полезнее.
$Neighbors = @(Get-NetNeighbor -AddressFamily IPv4 | Select-Object ifIndex,IPAddress,LinkLayerAddress,State)
$Neighbors | Export-Csv (Join-Path $OutDir 'NEIGHBORS_AFTER.csv') -NoTypeInformation -Encoding UTF8

$firstInt = [uint64]$scanSubnet.FirstHostInt
$lastInt  = [uint64]$scanSubnet.LastHostInt
$ipSet = New-Object 'System.Collections.Generic.HashSet[string]'
foreach ($p in $PingResults) { [void]$ipSet.Add($p.IP) }
foreach ($n in $Neighbors) {
    if (-not (Test-IPv4 $n.IPAddress)) { continue }
    try { $ni = Convert-IPv4ToUInt64 $n.IPAddress } catch { continue }
    if ($ni -lt $firstInt -or $ni -gt $lastInt) { continue }
    if ($n.State -in @('Unreachable','Incomplete')) { continue }
    [void]$ipSet.Add($n.IPAddress)
}
[void]$ipSet.Add($Primary.IPv4)

$pingIndex = @{}
foreach ($p in $PingResults) { $pingIndex[$p.IP] = $p }
$neighborIndex = @{}
foreach ($n in $Neighbors) { if ($n.IPAddress) { $neighborIndex[$n.IPAddress] = $n } }
$gatewayIps = @()
if ($Primary.Gateway) { $gatewayIps = @($Primary.Gateway -split ',\s*') }

Write-Section 'Инвентаризация найденных хостов'
$HostRows = New-Object 'System.Collections.Generic.List[object]'
$sortedIps = @($ipSet) | Sort-Object { Convert-IPv4ToUInt64 $_ }
foreach ($ip in $sortedIps) {
    $n = $neighborIndex[$ip]
    $name = if ($ip -eq $Primary.IPv4) { $env:COMPUTERNAME } else { Resolve-PtrName $ip }
    $role = ''
    if ($ip -eq $Primary.IPv4) { $role = 'THIS-PC' }
    elseif ($gatewayIps -contains $ip) { $role = 'GATEWAY' }
    [void]$HostRows.Add([pscustomobject]@{
        IPv4          = $ip
        Role          = $role
        Hostname      = $name
        LatencyMs     = if ($pingIndex.ContainsKey($ip)) { $pingIndex[$ip].LatencyMs } else { '' }
        MAC           = if ($n) { $n.LinkLayerAddress } else { '' }
        NeighborState = if ($n) { $n.State } else { '' }
        Discovery     = if ($ip -eq $Primary.IPv4) { 'LOCAL' } elseif ($pingIndex.ContainsKey($ip)) { 'ICMP' } else { 'ARP/NDP' }
        OpenTcp       = ''
    })
}
$Hosts = @($HostRows)
Write-ReportBlock (($Hosts | Format-Table IPv4,Role,Hostname,LatencyMs,MAC,NeighborState,Discovery -AutoSize | Out-String)) $TextReport
Write-Ok "Уникальных IPv4 хостов: $($Hosts.Count)"

Write-Section "TCP common-port scan • $($Cfg.CommonTcpPorts.Count) портов × $($Hosts.Count) хостов"
$OpenPorts = @()
if ($Hosts.Count -gt 0) {
    $OpenPorts = @(Invoke-TcpScan -Targets @($Hosts.IPv4) -Ports $Cfg.CommonTcpPorts -TimeoutMs $Cfg.PortTimeoutMs -Throttle $Cfg.PortThrottle -Activity 'Common TCP scan')
    $OpenPorts = @($OpenPorts | ForEach-Object {
        [pscustomobject]@{
            IPv4      = $_.IP
            Port      = $_.Port
            Service   = Get-PortService $_.Port
            State     = $_.State
            ConnectMs = $_.ConnectMs
        }
    } | Sort-Object { Convert-IPv4ToUInt64 $_.IPv4 }, Port)
}
if ($OpenPorts.Count -gt 0) {
    Write-ReportBlock (($OpenPorts | Format-Table IPv4,Port,Service,State,ConnectMs -AutoSize | Out-String)) $TextReport
    Write-Ok "Открытых common TCP портов: $($OpenPorts.Count)"
} else {
    Write-Info 'На выбранном наборе common TCP портов открытых портов не найдено.'
}

foreach ($h in $Hosts) {
    $p = @($OpenPorts | Where-Object { $_.IPv4 -eq $h.IPv4 } | Sort-Object Port | ForEach-Object {
        if ($_.Service) { "$($_.Port)/$($_.Service)" } else { "$($_.Port)" }
    })
    $h.OpenTcp = ($p -join ', ')
}
$Hosts | Export-Csv (Join-Path $OutDir 'HOSTS.csv') -NoTypeInformation -Encoding UTF8
$OpenPorts | Export-Csv (Join-Path $OutDir 'OPEN_COMMON_TCP_PORTS.csv') -NoTypeInformation -Encoding UTF8

Write-Section 'Локальные TCP/UDP порты Windows'
$procNames = @{}
foreach ($p in @(Get-Process)) { $procNames[$p.Id] = $p.ProcessName }
$LocalTcp = @(Get-NetTCPConnection -State Listen | ForEach-Object {
    [pscustomobject]@{
        LocalAddress = $_.LocalAddress
        LocalPort    = $_.LocalPort
        PID          = $_.OwningProcess
        Process      = $procNames[$_.OwningProcess]
    }
} | Sort-Object LocalPort,LocalAddress)
$LocalUdp = @(Get-NetUDPEndpoint | ForEach-Object {
    [pscustomobject]@{
        LocalAddress = $_.LocalAddress
        LocalPort    = $_.LocalPort
        PID          = $_.OwningProcess
        Process      = $procNames[$_.OwningProcess]
    }
} | Sort-Object LocalPort,LocalAddress)
$Established = @(Get-NetTCPConnection -State Established | Select-Object LocalAddress,LocalPort,RemoteAddress,RemotePort,OwningProcess,State)
$LocalTcp | Export-Csv (Join-Path $OutDir 'LOCAL_TCP_LISTENERS.csv') -NoTypeInformation -Encoding UTF8
$LocalUdp | Export-Csv (Join-Path $OutDir 'LOCAL_UDP_ENDPOINTS.csv') -NoTypeInformation -Encoding UTF8
$Established | Export-Csv (Join-Path $OutDir 'TCP_ESTABLISHED.csv') -NoTypeInformation -Encoding UTF8
Write-Ok "TCP listeners: $($LocalTcp.Count) • UDP endpoints: $($LocalUdp.Count) • established TCP: $($Established.Count)"
Write-ReportBlock (($LocalTcp | Select-Object -First 40 | Format-Table -AutoSize | Out-String)) $TextReport

Write-Section 'Windows Firewall'
$FirewallProfiles = @(Get-NetFirewallProfile | Select-Object Name,Enabled,DefaultInboundAction,DefaultOutboundAction,LogAllowed,LogBlocked,LogFileName)
$FirewallProfiles | Export-Csv (Join-Path $OutDir 'FIREWALL_PROFILES.csv') -NoTypeInformation -Encoding UTF8
Write-ReportBlock (($FirewallProfiles | Format-Table -AutoSize | Out-String)) $TextReport
$InboundAllow = @(Get-NetFirewallRule -Enabled True -Direction Inbound -Action Allow | Select-Object DisplayName,Profile,Direction,Action,Program,Service)
$InboundAllow | Export-Csv (Join-Path $OutDir 'FIREWALL_ENABLED_INBOUND_ALLOW_RULES.csv') -NoTypeInformation -Encoding UTF8
Write-Ok "Enabled inbound allow rules: $($InboundAllow.Count)"

Write-Section 'Опциональный глубокий TCP scan 1-65535'
Write-Info 'Common-порты всей локалки уже проверены. Ниже можно добить ОДИН свой IPv4 всеми 65535 TCP портами.'
$deepTarget = Read-Host '  IPv4 для deep scan (Enter = пропустить)'
$DeepPorts = @()
if ($deepTarget) {
    if (-not (Test-IPv4 $deepTarget)) {
        Write-Warn 'Некорректный IPv4, deep scan пропущен.'
    } else {
        Write-Warn "Сканирую $deepTarget: TCP 1-65535. Таймаут $($Cfg.DeepPortTimeoutMs) ms, параллельность $($Cfg.DeepPortThrottle)."
        $DeepRaw = @(Invoke-TcpScan -Targets @($deepTarget) -Ports (1..65535) -TimeoutMs $Cfg.DeepPortTimeoutMs -Throttle $Cfg.DeepPortThrottle -Activity "Deep TCP $deepTarget")
        $DeepPorts = @($DeepRaw | ForEach-Object {
            [pscustomobject]@{
                IPv4      = $_.IP
                Port      = $_.Port
                Service   = Get-PortService $_.Port
                State     = $_.State
                ConnectMs = $_.ConnectMs
            }
        } | Sort-Object Port)
        $safeName = $deepTarget.Replace('.','_')
        $DeepPorts | Export-Csv (Join-Path $OutDir ("DEEP_TCP_" + $safeName + '.csv')) -NoTypeInformation -Encoding UTF8
        if ($DeepPorts.Count) {
            Write-ReportBlock (($DeepPorts | Format-Table -AutoSize | Out-String)) $TextReport
            Write-Ok "Deep scan: открыто $($DeepPorts.Count) TCP портов."
        } else { Write-Info 'Deep scan: открытых TCP портов не найдено.' }
    }
}

Write-Section 'Формирование отчёта'
New-HtmlReport -Path $HtmlReport -PublicIp $PublicIp -SystemInfo $SystemInfo -Adapters $Adapters -Hosts $Hosts -OpenPorts $OpenPorts -LocalTcp $LocalTcp -LocalUdp $LocalUdp -FirewallProfiles $FirewallProfiles -DeepPorts $DeepPorts

$summary = @"

==================== SUMMARY ====================
Generated:       $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')
Computer:        $env:COMPUTERNAME
WAN IPv4:        $PublicIp
Primary IPv4:    $($Primary.IPv4)/$($Primary.Prefix)
Scanned subnet:  $($scanSubnet.Network)/$($scanSubnet.PrefixLength)
Addresses swept: $($Addresses.Count)
Hosts found:     $($Hosts.Count)
Common TCP open: $($OpenPorts.Count)
Local TCP listen:$($LocalTcp.Count)
Local UDP eps:   $($LocalUdp.Count)
Deep TCP open:   $($DeepPorts.Count)
Output:          $OutDir
=================================================
"@
$summary | Out-File -FilePath $TextReport -Encoding utf8 -Append

Write-Host ''
Write-Host '╔══════════════════════════════════════════════════════════════════════════════╗' -ForegroundColor Green
Write-Host '║                                  ГОТОВО                                     ║' -ForegroundColor Green
Write-Host '╚══════════════════════════════════════════════════════════════════════════════╝' -ForegroundColor Green
Write-Ok "Папка: $OutDir"
Write-Ok "HTML:  $HtmlReport"
Write-Info "Хостов: $($Hosts.Count) • common TCP open: $($OpenPorts.Count) • local TCP listeners: $($LocalTcp.Count)"
Write-Info 'Удалённый UDP специально не помечается как open/closed: без протокольного ответа простой UDP scan врёт как человек на собеседовании.'

try { Start-Process -FilePath $HtmlReport } catch {}
try { Start-Process explorer.exe -ArgumentList ('"' + $OutDir + '"') } catch {}
exit 0
