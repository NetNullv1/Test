function Clean([object]$Value) {
    if ($null -eq $Value) { return '' }
    return (($Value.ToString() -replace '[\r\n\t]+',' ') -replace '\s{2,}',' ').Trim()
}
function Is-PrivateIPv4([string]$Ip) {
    if ($Ip -match '^10\.') { return $true }
    if ($Ip -match '^192\.168\.') { return $true }
    if ($Ip -match '^172\.(1[6-9]|2[0-9]|3[01])\.') { return $true }
    return $false
}
function Ip-ToUInt32([string]$Ip) {
    $b = [Net.IPAddress]::Parse($Ip).GetAddressBytes()
    [Array]::Reverse($b)
    return [BitConverter]::ToUInt32($b,0)
}
function UInt32-ToIp([uint32]$Value) {
    $b = [BitConverter]::GetBytes($Value)
    [Array]::Reverse($b)
    return ([Net.IPAddress]::new($b)).ToString()
}
function Mask-ToPrefix([string]$Mask) {
    try {
        $bits = 0
        foreach ($o in $Mask.Split('.')) {
            $v = [int]$o
            for ($i=7; $i -ge 0; $i--) {
                if ($v -band (1 -shl $i)) { $bits++ }
            }
        }
        return $bits
    } catch { return 24 }
}
function Get-Range([string]$Ip, [int]$Prefix) {
    if ($Prefix -lt 24) {
        $p = $Ip.Split('.')
        return [pscustomobject]@{
            First = Ip-ToUInt32 ($p[0]+'.'+$p[1]+'.'+$p[2]+'.1')
            Last  = Ip-ToUInt32 ($p[0]+'.'+$p[1]+'.'+$p[2]+'.254')
            Label = ($p[0]+'.'+$p[1]+'.'+$p[2]+'.0/24 (limited from /'+$Prefix+')')
        }
    }
    $u = [uint64](Ip-ToUInt32 $Ip)
    if ($Prefix -ge 31) {
        return [pscustomobject]@{ First=[uint32]$u; Last=[uint32]$u; Label=($Ip+'/'+$Prefix) }
    }
    $all = [uint64]4294967295
    $mask64 = ($all -shl (32-$Prefix)) -band $all
    $net64 = $u -band $mask64
    $size = [uint64][Math]::Pow(2,(32-$Prefix))
    $broadcast64 = $net64 + $size - 1
    return [pscustomobject]@{
        First = [uint32]($net64 + 1)
        Last  = [uint32]($broadcast64 - 1)
        Label = ((UInt32-ToIp ([uint32]$net64)) + '/' + $Prefix)
    }
}
function Resolve-NameTimed([string]$Ip, [int]$TimeoutMs = 650) {
    try {
        $ar = [Net.Dns]::BeginGetHostEntry($Ip,$null,$null)
        if ($ar.AsyncWaitHandle.WaitOne($TimeoutMs,$false)) {
            return ([Net.Dns]::EndGetHostEntry($ar)).HostName
        }
    } catch {}
    return ''
}
function Test-Tcp([string]$Ip,[int]$Port,[int]$TimeoutMs=220) {
    $c = New-Object Net.Sockets.TcpClient
    try {
        $a = $c.BeginConnect($Ip,$Port,$null,$null)
        if ($a.AsyncWaitHandle.WaitOne($TimeoutMs,$false) -and $c.Connected) {
            try { $c.EndConnect($a) } catch {}
            return $true
        }
    } catch {}
    finally { try { $c.Close() } catch {} }
    return $false
}
function Get-ArpMap {
    $map = @{}
    try {
        foreach ($line in (arp -a)) {
            if ($line -match '^\s*(\d{1,3}(?:\.\d{1,3}){3})\s+([0-9a-fA-F-]{17})\s+') {
                $map[$matches[1]] = $matches[2].ToUpper()
            }
        }
    } catch {}
    return $map
}
function Get-VendorHint([string]$Mac) {
    if (-not $Mac) { return '' }
    $m = $Mac.ToUpper().Replace(':','-')
    $oui = ($m.Split('-')[0..2] -join '-')
    $known = @{
        'AC-1F-6B'='Supermicro'
        '3C-EC-EF'='Supermicro'
        '08-00-27'='Oracle VirtualBox'
        'F0-9F-C2'='Ubiquiti'
        'E0-63-DA'='Ubiquiti'
        '00-12-34'='Camille Bauer'
        '50-FF-20'='Keenetic'
        '00-1E-67'='Intel'
    }
    if ($known.ContainsKey($oui)) { return $known[$oui] }
    return $oui
}
